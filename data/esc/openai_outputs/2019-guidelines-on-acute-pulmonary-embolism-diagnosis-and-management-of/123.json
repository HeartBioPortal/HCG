{
  "content": {
    "title": "Recommendations on IVC filters",
    "recommendations": [
      {
        "text": "IVC filters should be considered in patients with acute PE and absolute contraindications to anticoagulation.",
        "Class": "IIa",
        "Level": "C",
        "citation": null
      },
      {
        "text": "IVC filters should be considered in cases of PE recurrence despite therapeutic anticoagulation.",
        "Class": "IIa",
        "Level": "C",
        "citation": null
      },
      {
        "text": "Routine use of IVC filters is not recommended.",
        "Class": "III",
        "Level": "A",
        "citation": "[302–304]"
      }
    ],
    "abbreviations": {
      "IVC": "inferior vena cava",
      "PE": "pulmonary embolism"
    },
    "footnotes": {
      "a": "Class of recommendation.",
      "b": "Level of evidence."
    },
    "source": "ESC 2019 (as displayed on page)"
  },
  "genes": []
}