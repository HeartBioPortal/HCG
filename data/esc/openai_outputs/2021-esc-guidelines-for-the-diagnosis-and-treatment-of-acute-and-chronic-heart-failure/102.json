      "Confusion (especially in the elderly)",
      "Depression",
      "Palpitation",
      "Dizziness",
      "Syncope",
      "Bendopnea"
    ],
    "Less specific Signs": [
      "Weight gain (>2 kg/week)",
      "Weight loss (in advanced HF)",
      "Tissue wasting (cachexia)",
      "Cardiac murmur",
