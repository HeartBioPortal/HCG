    "Drug Classes": [
      {
        "Class": "Diuretics\u2013aldosterone antagonists",
        "Drugs": {
          "Eplerenone": {
            "Usual Dose": "50-100 mg/d",
            "Daily Frequency": "1 or 2",
            "Comments": [
              "Preferred agents in primary aldosteronism and resistant hypertension.",
              "Requires twice-daily dosing for adequate BP lowering."
            ]
          },
          "Spironolactone": {
            "Usual Dose": "25-100 mg/d",
            "Daily Frequency": "1",
            "Comments": [
              "Associated with greater risk of gynecomastia and impotence compared to eplerenone.",
              "Common add-on therapy in resistant hypertension.",
              "Avoid with K+ supplements, other K+-sparing diuretics, or significant renal dysfunction."
            ]
          }
        }
      },
      {
        "Class": "Beta blockers\u2013cardioselective",
        "Drugs": {
          "Atenolol": {
            "Usual Dose": "25-100 mg/d",
            "Daily Frequency": "2",
            "Comments": [
              "Not recommended as first-line agents unless the patient has IHD or HF."
            ]
          },
          "Betaxolol": {
            "Usual Dose": "5-20 mg/d",
            "Daily Frequency": "1"
          },
          "Bisoprolol": {
            "Usual Dose": "2.5-10 mg/d",
            "Daily Frequency": "1",
            "Comments": [
              "Preferred in patients with bronchospastic airway disease requiring a beta blocker."
            ]
          },
          "Metoprolol tartrate": {
            "Usual Dose": "100-200 mg/d",
            "Daily Frequency": "2",
            "Comments": [
              "Preferred in patients with HFrEF."
            ]
          },
          "Metoprolol succinate": {
            "Usual Dose": "50-200 mg/d",
            "Daily Frequency": "1"
          }
        }
      },
      {
        "Class": "Beta blockers\u2013cardioselective and vasodilatory",
        "Drugs": {
          "Nebivolol": {
            "Usual Dose": "5-40 mg/d",
            "Daily Frequency": "1",
            "Comments": [
              "Includes nitric oxide-induced vasodilation."
            ]
          }
        }
      },
      {
        "Class": "Beta blockers\u2013noncardioselective",
        "Drugs": {
          "Nadolol": {
            "Usual Dose": "40-120 mg/d",
            "Daily Frequency": "1",
            "Comments": [
              "Avoid in patients with reactive airways disease."
            ]
          },
          "Propranolol IR": {
            "Usual Dose": "80-160 mg/d",
            "Daily Frequency": "2",
            "Comments": [
              "Avoid abrupt cessation."
            ]
          },
