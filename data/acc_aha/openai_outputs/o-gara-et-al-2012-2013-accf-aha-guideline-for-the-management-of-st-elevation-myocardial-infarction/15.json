{
  "content": {
    "title": "Adjuvant Antithrombotic Therapy to Support Reperfusion With Primary PCI",
    "antiplatelet_therapy": {
      "aspirin": {
        "dosing": "162- to 325-mg load before procedure; 81- to 325-mg daily maintenance",
        "notes": "81 mg daily is the preferred maintenance dose",
        "class_of_recommendation": "I, I, IIa",
        "level_of_evidence": "B, A, B",
        "references": "251-253, 254,255,257, 253,254,263,264"
      },
      "p2y12_inhibitors": {
        "loading_doses": {
          "clopidogrel": "600 mg at time of PCI",
          "prasugrel": "60 mg at time of PCI",
          "ticagrelor": "180 mg at time of PCI",
          "class_of_recommendation": "I, I, I",
          "level_of_evidence": "B, B, B",
          "references": "253,258,259, 260, 261"
        },
        "maintenance_doses": {
          "des_placed": {
            "clopidogrel": "75 mg daily",
            "prasugrel": "10 mg daily",
            "ticagrelor": "90 mg twice a day",
            "class_of_recommendation": "I, I, I",
            "level_of_evidence": "B, B, B",
            "references": "260,262, 262, 261"
          },
          "bmst_placed": {
            "clopidogrel": "75 mg daily",
            "prasugrel": "10 mg daily",
            "ticagrelor": "90 mg twice a day",
            "class_of_recommendation": "I, I, I",
            "level_of_evidence": "B, B, B",
            "references": "260,262, 262, 261"
          }
        },
        "extended_therapy": {
          "only": "clopidogrel, prasugrel, or ticagrelor",
          "class_of_recommendation": "IIb, III",
          "level_of_evidence": "C, Harm",
          "references": "N/A, 260"
        }
      },
      "iv_gp_iiib_iiia_receptor_antagonists": {
        "abciximab": "0.25-mg/kg IV bolus, then 0.125 mcg/kg/min",
        "tirofiban": "25-mcg/kg IV bolus, then 0.15 mcg/kg/min",
        "eptifibatide": "180-mcg/kg bolus; second bolus 10 min after first",
        "class_of_recommendation": "IIa, IIa, IIa",
        "level_of_evidence": "A, B, B",
        "references": "265-267, 268,269, 270",
        "notes": "Certain conditions for infusion rate and procedures prior to catheterization"
      }
    },
    "anticoagulant_therapy": {
      "ufh": {
        "dosing": [
          "with GP IIb/IIIa receptor antagonist: 50- to 70-U/kg IV bolus",
          "without GP IIb/IIIa receptor antagonist: 70- to 100-U/kg bolus"
        ],
        "class_of_recommendation": "I, I",
        "level_of_evidence": "C, C",
        "references": "N/A, N/A",
        "additional_notes": "Reduce infusion if CrCl <30 mL/min"
      },
      "bivalirudin": {
        "dosing": "0.75-mg/kg IV bolus, then 1.75-mg/kg/h infusion",
        "class_of_recommendation": "I",
        "level_of_evidence": "B",
        "references": "248"
      },
      "fondaparinux": {
        "note": "Not recommended as sole anticoagulant for primary PCI",
        "class_of_recommendation": "III",
        "level_of_evidence": "Harm",
        "references": "304"
      }
    }
  },
  "genes": []
